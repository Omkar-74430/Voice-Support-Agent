# =============================================================================
# Voice Support Agent — configuration (copy to .env). Never commit real secrets.
# =============================================================================

# ---- App ---------------------------------------------------------------------
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# JSON logs (set false for readable local logs)
LOG_JSON=true
# comma separated; never "*" in staging/production
CORS_ORIGINS=http://localhost:3000
# public POST /v1/auth/signup. Set false in production and onboard tenants yourself
ALLOW_TENANT_SIGNUP=true
# /docs, /redoc, /openapi.json — set false in production
EXPOSE_DOCS=true
# true only behind a trusted load balancer (X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=false
# if set, GET /metrics requires "Authorization: Bearer <token>"
METRICS_TOKEN=

# ---- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- MongoDB (Atlas or mongodb-atlas-local; Atlas Search + Vector Search required for RAG) ----
MONGODB_URI=mongodb://localhost:27017/?directConnection=true
MONGODB_DB=voice_support
# TTL for conversations + messages (0 = keep forever)
CONVERSATION_RETENTION_DAYS=90

# ---- AWS (credentials come from the default chain: env vars, profile, ECS/EKS role) ----
# Local development only (use an IAM role in AWS):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=default           # docker compose mounts ~/.aws read-only
AWS_REGION=ap-south-1
# Use an inference-profile ID (global./apac./us.) that is enabled in YOUR account and region.
BEDROCK_LLM_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# query rewriting
BEDROCK_FAST_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# or cohere.embed-multilingual-v3
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# must match the model AND the Atlas vector index
EMBEDDING_DIMENSIONS=1024
# optional Bedrock Guardrail (PII / denied topics / grounding)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT
LLM_MAX_TOKENS=450
LLM_TEMPERATURE=0.2

# ---- S3 ----------------------------------------------------------------------
S3_BUCKET=voice-support-agent-data
# none | AES256 | aws:kms
S3_SSE=AES256
S3_KMS_KEY_ID=
# keep call audio in S3 (disable if you must not retain voice data)
STORE_AUDIO=true
# Local MinIO only:
# S3_ENDPOINT_URL=http://localhost:9000
# S3_FORCE_PATH_STYLE=true
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ---- Sarvam AI ---------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_STT_MODE=transcribe
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_TTS_PACE=1.0

# ---- RAG ---------------------------------------------------------------------
RAG_TOP_K=5
# Atlas cosine score = (1 + cos) / 2
RAG_MIN_VECTOR_SCORE=0.6
RAG_HYBRID_ENABLED=true
RAG_QUERY_REWRITE=true
RAG_CHUNK_SIZE_CHARS=1100
RAG_CHUNK_OVERLAP_CHARS=180

# ---- Ingestion ---------------------------------------------------------------
# inline (in API process) | worker (python -m app.worker)
INGESTION_MODE=inline
INGESTION_CONCURRENCY=2
MAX_UPLOAD_MB=25

# ---- Voice -------------------------------------------------------------------
# server-side end-of-speech detection
VAD_ENABLED=true
VAD_SILENCE_MS=700
VAD_ENERGY_THRESHOLD=0.015
MAX_UTTERANCE_SECONDS=30
TTS_PARALLELISM=3

# ---- Rate limits (per minute) ------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240
RATE_LIMIT_VOICE_PER_MINUTE=40
